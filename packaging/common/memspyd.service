[Unit]
Description=MemSpy fileless malware detection service
Documentation=man:memspyd(8)
After=local-fs.target
ConditionPathExists=/sys/kernel/btf/vmlinux

[Service]
Type=simple
User=root
Group=memspy-ui
ExecStart=/opt/memspy/bin/memspyd --foreground
Restart=on-failure
RestartSec=5s
RuntimeDirectory=memspy
RuntimeDirectoryMode=0750
StateDirectory=memspy
StateDirectoryMode=0700
UMask=0077

CapabilityBoundingSet=CAP_SYS_ADMIN CAP_BPF CAP_PERFMON CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/memspy /run/memspy -/sys/fs/bpf/memspy
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @mount @reboot @swap
SystemCallErrorNumber=EPERM
TasksMax=128

[Install]
WantedBy=multi-user.target
